{
  "name": "inochi-agent-tools",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["packages/*"],
  "scripts": {
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit",
    "core:build": "tsc -p packages/core/tsconfig.json",
    "test": "npm run sdk:build && vitest run",
    "verify": "npm run typecheck && npm run cli:typecheck && npm run sdk:typecheck && npm run mcp:typecheck && npm test",
    "cli:typecheck": "tsc -p packages/cli/tsconfig.json --noEmit",
    "cli:build": "npm run core:build && tsc -p packages/cli/tsconfig.json",
    "cli:test": "npm run core:build && vitest run packages/cli/test",
    "sdk:typecheck": "tsc -p packages/sdk/tsconfig.json --noEmit",
    "sdk:build": "npm run core:build && tsc -p packages/sdk/tsconfig.json",
    "sdk:test": "npm run core:build && vitest run packages/sdk/test",
    "mcp:typecheck": "tsc -p packages/mcp/tsconfig.json --noEmit",
    "mcp:build": "npm run sdk:build && tsc -p packages/mcp/tsconfig.json",
    "mcp:test": "npm run sdk:build && vitest run packages/mcp/test/mcp-contract.test.ts",
    "mcp:protocol:test": "vitest run packages/mcp/test/mcp-parity.test.ts",
    "mcp:real-workflow:test": "vitest run packages/mcp/test/mcp-real-workflow.test.ts",
    "m3:protocol:ci": "node scripts/mcp/m3-protocol-ci.mjs",
    "m3:mcp:ci": "node scripts/mcp/m3-mcp-ci.mjs",
    "v1:artifacts": "node scripts/v1/build-agent-artifacts.mjs",
    "v1:verify-artifacts": "node scripts/v1/verify-agent-artifacts.mjs",
    "v1:artifacts:test": "vitest run tests/integration/v1-agent-artifacts.test.ts",
    "v1:ci": "node scripts/v1/v1-acceptance-ci.mjs",
    "v1.1:bundle": "npm run cli:build && npm run mcp:build && node scripts/package/build-bundle.mjs",
    "v1.1:package:ci": "node scripts/package/v1.1-package-ci.mjs",
    "upstream:materialize": "node scripts/upstream/materialize.mjs",
    "upstream:verify": "node scripts/upstream/verify.mjs",
    "upstream:fingerprint": "node scripts/upstream/fingerprint.mjs",
    "native:toolchain:verify": "node scripts/native/verify-toolchain.mjs",
    "native:build": "node scripts/native/build-bridge.mjs",
    "native:probe": "node scripts/native/build-bridge.mjs --probe",
    "native:ci": "npm run upstream:materialize && npm run upstream:verify && npm run native:toolchain:verify && npm run native:build && npm run native:probe && npm run upstream:fingerprint -- --json",
    "m1:fixture": "node scripts/native/build-host.mjs --fixture",
    "m1:inspection-probe": "node scripts/native/build-host.mjs --inspection-probe",
    "m1:probe": "node scripts/native/build-host.mjs --inspection-probe",
    "m1:create-probe": "node scripts/native/build-host.mjs --create-probe",
    "m1:create-host": "node scripts/native/build-host.mjs --create-host-probe",
    "m1:host": "node scripts/native/build-host.mjs --host",
    "m1:host:build": "node scripts/native/build-host.mjs --host",
    "m1:ci": "node scripts/native/m1-ci.mjs",
    "m1:authoring:ci": "node scripts/native/m1-authoring-ci.mjs",
    "m2:png": "node scripts/fixtures/write-m2-png.mjs",
    "m2:visual-probe": "node scripts/native/build-host.mjs --visual-probe",
    "m2:visual-host": "node scripts/native/build-host.mjs --visual-host-probe",
    "m2:visual:ci": "node scripts/native/m2-visual-ci.mjs",
    "m2:binding-serde-probe": "dub run --root native/bridge --config=binding-serde-probe",
    "m2:parameter-probe": "node scripts/native/parameter-authoring-probe.mjs",
    "m2:parameter-evaluation-probe": "node scripts/native/parameter-evaluation-probe.mjs",
    "m2:parameter:ci": "node scripts/native/m2-parameter-ci.mjs",
    "creator:materialize": "node scripts/creator/materialize.mjs",
    "creator:fixture": "node scripts/creator/build-fixture.mjs",
    "creator:roundtrip": "node scripts/creator/launch-roundtrip.mjs",
    "creator:verify": "node scripts/creator/verify-roundtrip.mjs",
    "m2:creator:ci": "node scripts/creator/m2-creator-ci.mjs",
    "m3:save:ci": "node scripts/cli/m3-save-ci.mjs",
    "m3:cli:ci": "node scripts/cli/m3-cli-ci.mjs",
    "v1.2:rig-primitives:ci": "node scripts/v1.2/rig-primitives-ci.mjs",
    "v1.3:visual-controls:ci": "node scripts/v1.3/visual-controls-ci.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
