{
  "name": "inochi-agent-tools",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["packages/*"],
  "scripts": {
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test",
    "upstream:materialize": "node scripts/upstream/materialize.mjs",
    "upstream:verify": "node scripts/upstream/verify.mjs",
    "upstream:fingerprint": "node scripts/upstream/fingerprint.mjs",
    "native:toolchain:verify": "node scripts/native/verify-toolchain.mjs",
    "native:build": "node scripts/native/build-bridge.mjs",
    "native:probe": "node scripts/native/build-bridge.mjs --probe",
    "native:ci": "npm run upstream:materialize && npm run upstream:verify && npm run native:toolchain:verify && npm run native:build && npm run native:probe && npm run upstream:fingerprint -- --json",
    "m1:fixture": "node scripts/native/build-host.mjs --fixture",
    "m1:inspection-probe": "node scripts/native/build-host.mjs --inspection-probe",
    "m1:probe": "node scripts/native/build-host.mjs --inspection-probe",
    "m1:create-probe": "node scripts/native/build-host.mjs --create-probe",
    "m1:create-host": "node scripts/native/build-host.mjs --create-host-probe",
    "m1:host": "node scripts/native/build-host.mjs --host",
    "m1:host:build": "node scripts/native/build-host.mjs --host",
    "m1:ci": "node scripts/native/m1-ci.mjs",
    "m1:authoring:ci": "node scripts/native/m1-authoring-ci.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
