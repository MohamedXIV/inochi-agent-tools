+/**
+    Projects a GUID into the legacy 32-bit node identity namespace.
+
+    This uses the UUID time-low field represented by the first eight
+    hexadecimal characters. Legacy IDs upgraded through toGuid therefore
+    round-trip exactly, while native GUIDs receive a stable compatibility ID.
+*/
+uint toLegacyUUID(GUID guid) {
+    auto text = guid.toString();
+    uint value;
+    foreach (c; text[0..8]) {
+        value <<= 4;
+        if (c >= '0' && c <= '9')
+            value |= cast(uint)(c - '0');
+        else if (c >= 'a' && c <= 'f')
+            value |= cast(uint)(c - 'a' + 10);
+        else if (c >= 'A' && c <= 'F')
+            value |= cast(uint)(c - 'A' + 10);
+    }
+    return value == uint.max ? uint.max - 1 : value;
+}
